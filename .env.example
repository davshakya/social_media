OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# --provider openai or gemini controls planning, speech, and enabled images.
AI_API_KEY=
AI_PLANNER_PROVIDER=gemini
AI_PLANNER_MODEL=
AI_BASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
YOUTUBE_VISIBILITY=public
# Set local for Pillow images, auto for AI images, or none for only Blender visuals.
TOPIC_IMAGE_PROVIDER=none
TOPIC_IMAGE_API_KEY=
TOPIC_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
# The voice uses Hinglish; all captions and scene labels remain English-only.
# Hinglish narration uses Devanagari Hindi plus English science terms.
# On-screen captions and 3D labels are English-only.
# Optional executable overrides (absolute paths, no surrounding quotes needed):
BLENDER_PATH=
FFMPEG_PATH=
# A directory containing a Devanagari font, e.g. Noto Sans Devanagari.
FONT_DIR=C:/Windows/Fonts
CAPTION_FONT=Nirmala UI
