OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
# The voice uses Hinglish; all captions and scene labels remain English-only.
# Hinglish narration uses Devanagari Hindi plus English science terms.
# On-screen captions and 3D labels are English-only.
# Optional executable overrides (absolute paths, no surrounding quotes needed):
BLENDER_PATH=
FFMPEG_PATH=
# A directory containing a Devanagari font, e.g. Noto Sans Devanagari.
FONT_DIR=C:/Windows/Fonts
CAPTION_FONT=Nirmala UI
