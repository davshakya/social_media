# Add these settings to .env. Keep actual tokens out of chat and source control.
# Create a Desktop OAuth client in your Google Cloud project, enable YouTube Data API v3,
# and save the downloaded client JSON at .secrets/youtube-client.json.
YOUTUBE_CLIENT_SECRET_FILE=.secrets/youtube-client.json
YOUTUBE_TOKEN_FILE=.secrets/youtube-token.json
# Choose the Graph API version enabled for your Meta app, e.g. v25.0.
META_GRAPH_VERSION=
# Facebook Page access token (not an app token or ordinary User access token).
# Instagram must be a professional account linked to this Facebook Page.
META_PAGE_ACCESS_TOKEN=
